# macOS system files
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns
.com.apple.timemachine.donotpresent
.fseventsd
Thumbs.db
ehthumbs.db
Icon?

# Visual Studio Code workspace files
.vscode/
!.vscode/settings.json          # ← keep if you want shared settings
!.vscode/tasks.json             # ← keep if you want shared tasks
!.vscode/launch.json            # ← keep if you want shared debug configs
!.vscode/extensions.json
!.vscode/*.code-snippets

# C / C++ build artifacts
*.o
*.obj
*.lo
*.slo
*.a
*.lib
*.so
*.dylib           # macOS dynamic libraries
*.dll
*.exe
*.out             # common executable name on Unix/macOS
*.app             # macOS application bundle (if you build one)
*.i*              # preprocessed files
*.ii
*.s
*.su
*.bc
*.d               # dependency files
*.deps
*.gcno
*.gcda
*.gcov
*.pdb
*.ilk
*.idb
*.pch             # precompiled headers
*.gch

# Common build directories
build/
Build/
build-*/
out/
bin/
Bin/
obj/
Obj/
Debug/
debug/
Release/
release/
x64/
x86/
cmake-build-*/
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
CPack*
*.cmake
*.ninja*
compile_commands.json     # often generated by cmake & clangd
compile_flags.txt
.linker_map

# clangd / LSP related (very common in VS Code C/C++ setups)
.clangd/
.cache/
compile_commands.json
compile_flags.txt

# CMake / vcpkg / conan
vcpkg_installed/
vcpkg/
conanbuildinfo.*
conanfile.txt.lock
conan.lock
_installed_packages/

# Unit test / coverage folders
coverage/
lcov-html/
test-results/
*.profraw
*.profdata

# Logs and temporary files
*.log
*.tmp
*.bak
*~

# macOS-specific C++ tools sometimes create these
*.dSYM/           # debug symbols folder
*.dSYM
*.ipa

# Optional: ignore very large / generated files you usually don't commit
*.png
*.jpg
*.zip
*.tar.gz
*.tgz
